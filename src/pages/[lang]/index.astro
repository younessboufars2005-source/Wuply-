---
import Base from '../../layouts/Base.astro';
import ImmersiveHero from '../../components/ImmersiveHero.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import BraceletCollections from '../../components/BraceletCollections.astro';
import { locales, translations } from '../../i18n';
import { storefront } from '../../i18n/storefront';
import { straps } from '../../data/catalog';
import { visuals, visualAlt } from '../../data/visuals';
export function getStaticPaths() { return locales.map(lang => ({params:{lang},props:{lang}})); }
const {lang} = Astro.props;
const s = storefront[lang]; const t = translations[lang]; const alt = visualAlt[lang];

---
<Base lang={lang} title={s.title} description={s.description}>
 <ImmersiveHero lang={lang}/>
 <section class="collection-editorial wrap" id="collections">
  <div class="editorial-heading" data-reveal><span class="eyebrow">{s.collectionsLabel}</span><h2>{s.collectionsTitle}</h2></div>
  <div class="collection-panels">{straps.map((collection,i) => {
   const visual = i === 0 ? visuals.classic : visuals.original;
   return <article class:list={['collection-panel',i === 1 && 'collection-panel--original']} data-reveal><a class="collection-panel-image" href={`/${lang}/catalog/#${collection.id}`} tabindex="-1" aria-hidden="true">{visual ? <><ResponsivePhoto image={visual} alt={i === 0 ? alt.classic : alt.original}/><span class="panel-credit">{s.ad}</span></> : <div class="collection-product-pair">{[collection.variants[0],collection.variants[i === 0 ? 10 : 1]].map(v => <ResponsivePhoto image={v.image!} alt=""/>)}</div>}</a><div class="collection-panel-copy"><span class="eyebrow">0{i+1} / {collection.variants.length}</span><h3>{collection.name[lang]}</h3><p>{i === 0 ? s.classicText : s.originalText}</p><a class="button light" href={`/${lang}/catalog/#${collection.id}`}>{s.explore}<span>↗</span></a></div></article>;
  })}</div>
 </section>
 <section class="featured-products wrap" id="catalogue"><div class="section-title" data-reveal><div><span class="eyebrow">02 / {s.navCatalog}</span><h2>{s.selection}</h2><p>{s.selectionText}</p></div><a class="text-link" href={`/${lang}/catalog/`}>{s.all} ↗</a></div><BraceletCollections lang={lang} featured/></section>
 {visuals.lifestyle && <section class="lifestyle-editorial" id="experience"><ResponsivePhoto image={visuals.lifestyle} alt={alt.lifestyle}/><div class="lifestyle-copy wrap" data-reveal><span class="eyebrow">03 / {s.tag}</span><h2>{s.lifestyle}</h2><p>{s.lifestyleText}</p><a class="button light" href={`/${lang}/catalog/`}>{s.discover} ↗</a></div><span class="editorial-credit">{s.ad}</span></section>}
 <section class="daily-strip wrap" aria-label={s.lifestyleText}>{[visuals.everyday,visuals.office].filter(Boolean).map((visual,i) => <figure data-reveal><ResponsivePhoto image={visual!} alt={i === 0 ? alt.everyday : alt.office}/><figcaption>{s.lifestyleText}<span class="tiny">{s.ad}</span></figcaption></figure>)}</section>
 <section class="style-editorial wrap"><div class="style-copy" data-reveal><span class="eyebrow">04 / {s.colors}</span><h2>{s.personal}</h2><p>{s.personalText}</p><a class="button light" href={`/${lang}/product/`}>{s.personalCta}<span>↗</span></a></div><div class="style-images" data-reveal>{visuals.personal ? <ResponsivePhoto class="style-ad" image={visuals.personal} alt={alt.personal}/> : [straps[0].variants[4],straps[0].variants[10],straps[1].variants[2]].map(v => <a href={`/${lang}/product/?strap=${v.id}#configuration`}><ResponsivePhoto image={v.image!} alt={v.name[lang]}/></a>)}</div></section>
 <section class="detail-editorial wrap" id="details"><div class="detail-image" data-reveal>{visuals.detail ? <figure><ResponsivePhoto image={visuals.detail} alt={alt.detail}/><figcaption>{s.ad}</figcaption></figure> : <ResponsivePhoto image={straps[0].variants[12].image!} alt={straps[0].variants[12].name[lang]}/>}{visuals.desk && <ResponsivePhoto class="detail-inset" displayWidth={160} image={visuals.desk} alt={alt.desk}/>}</div><div class="detail-copy" data-reveal><span class="eyebrow">05 / {s.detailsLabel}</span><h2>{s.detailsTitle}</h2><p>{s.detailsText}</p><a class="text-link" href={`/${lang}/catalog/`}>{s.all} ↗</a>{visuals.turquoise && <figure class="detail-inset"><ResponsivePhoto displayWidth={160} image={visuals.turquoise} alt={alt.turquoise}/><figcaption class="tiny">{s.ad}</figcaption></figure>}</div></section>
 <section class="information store-information wrap" id="information"><div><span class="eyebrow">{s.help}</span><h2>{s.helpTitle}</h2><p>{s.helpText}</p><p class="compatibility-note">{s.compatibility}</p></div><div class="faq"><details><summary>{t.faq1}<span aria-hidden="true">+</span></summary><p>{t.answer1}</p></details><details id="delivery"><summary>{s.shipping}<span aria-hidden="true">+</span></summary><p>{s.notActive}</p></details><details id="returns"><summary>{s.returns}<span aria-hidden="true">+</span></summary><p>{s.notActive}</p></details><details id="legal"><summary>{s.legal}<span aria-hidden="true">+</span></summary><p>{s.independent}</p><p>{s.commercial}</p></details></div></section>
</Base>
