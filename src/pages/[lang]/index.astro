---
import Base from '../../layouts/Base.astro';
import ImmersiveHero from '../../components/ImmersiveHero.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import BraceletCollections from '../../components/BraceletCollections.astro';
import { locales } from '../../i18n';
import { storefront } from '../../i18n/storefront';
import { straps } from '../../data/catalog';
import { visualAlt } from '../../data/visuals';
import ArrowIcon from '../../components/ArrowIcon.astro';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props; const s=storefront[lang]; const alt=visualAlt[lang];
const c={
 fr:{benefits:['Application gratuite','Bracelets interchangeables','Résistant à l’eau','Sans abonnement'],deviceLabel:'02 / LE BRACELET CONNECTÉ',deviceTitle:'LA TECHNOLOGIE,\nSANS EN FAIRE TROP.',deviceText:'Un dispositif discret associé à des bracelets interchangeables et à une application mobile simple.',deviceCta:'DÉCOUVRIR LE DISPOSITIF',collectionsLabel:'03 / NOS COLLECTIONS',collectionsTitle:'DEUX COLLECTIONS.\nUNE SEULE RÈGLE : LA VÔTRE.',models:'modèles',selection:'UNE SÉLECTION WUPLY',selectionText:'Des couleurs, des motifs et des finitions pour composer votre style.',personalLabel:'05 / PERSONNALISATION',personalTitle:'CHANGEZ DE BRACELET.\nGARDEZ VOTRE STYLE.',personalText:'Du noir au turquoise, du beige au bordeaux : chaque variante présentée appartient au catalogue WUPLY.',personalCta:'OUVRIR LE CONFIGURATEUR',detailsLabel:'06 / MATIÈRES & DÉTAILS',detailsTitle:'LE CARACTÈRE\nEST DANS LE DÉTAIL.',detailsText:'Textile, coutures, couleurs et finitions métalliques composent une présence discrète au poignet.',appLabel:'07 / APPLICATION',appTitle:'VOS DONNÉES.\nSIMPLEMENT.',appText:'Une application gratuite, une utilisation simple et aucun abonnement.',faqLabel:'08 / QUESTIONS',faqTitle:'L’ESSENTIEL,\nEN TOUTE CLARTÉ.',questions:[['Comment fonctionne WUPLY ?','Le dispositif s’associe à un bracelet interchangeable et poursuit l’expérience dans une application mobile.'],['L’application est-elle gratuite ?','Oui, l’application est présentée comme gratuite.'],['Faut-il un abonnement ?','Aucun abonnement n’est prévu.'],['Puis-je changer de bracelet ?','Oui. Les 19 variantes du catalogue peuvent être explorées dans le configurateur.'],['Le bracelet résiste-t-il à l’eau ?','La résistance à l’eau doit être confirmée dans les spécifications commerciales définitives.']]},
 en:{benefits:['Free mobile app','Interchangeable bands','Water resistant','No subscription'],deviceLabel:'02 / THE CONNECTED BAND',deviceTitle:'TECHNOLOGY,\nWITHOUT THE NOISE.',deviceText:'A discreet device paired with interchangeable bands and a simple mobile application.',deviceCta:'DISCOVER THE DEVICE',collectionsLabel:'03 / OUR COLLECTIONS',collectionsTitle:'TWO COLLECTIONS.\nONE RULE: YOURS.',models:'styles',selection:'A WUPLY SELECTION',selectionText:'Colours, patterns and finishes to compose your style.',personalLabel:'05 / PERSONALISATION',personalTitle:'CHANGE THE BAND.\nKEEP YOUR STYLE.',personalText:'From black to turquoise, beige to burgundy: every variant shown belongs to the WUPLY catalogue.',personalCta:'OPEN THE CONFIGURATOR',detailsLabel:'06 / MATERIALS & DETAILS',detailsTitle:'CHARACTER LIVES\nIN THE DETAILS.',detailsText:'Textile, stitching, colour and metal finishes create a discreet presence on the wrist.',appLabel:'07 / APPLICATION',appTitle:'YOUR DATA.\nSIMPLY.',appText:'A free application, simple to use, with no subscription.',faqLabel:'08 / QUESTIONS',faqTitle:'THE ESSENTIALS,\nWITH CLARITY.',questions:[['How does WUPLY work?','The device pairs with an interchangeable band and continues the experience in a mobile application.'],['Is the application free?','Yes, the application is presented as free.'],['Do I need a subscription?','No subscription is planned.'],['Can I change the band?','Yes. All 19 catalogue variants can be explored in the configurator.'],['Is the band water resistant?','Water resistance remains subject to final commercial specifications.']]},
 ar:{benefits:['تطبيق مجاني','أحزمة قابلة للتبديل','مقاوم للماء','بدون اشتراك'],deviceLabel:'02 / السوار المتصل',deviceTitle:'تقنية هادئة،\nبلا تعقيد.',deviceText:'جهاز بتصميم هادئ مع أحزمة قابلة للتبديل وتطبيق هاتف بسيط.',deviceCta:'اكتشف الجهاز',collectionsLabel:'03 / مجموعاتنا',collectionsTitle:'مجموعتان.\nوالقاعدة أنت.',models:'تصاميم',selection:'مختارات WUPLY',selectionText:'ألوان ونقوش وتشطيبات لتكوين أسلوبك.',personalLabel:'05 / التخصيص',personalTitle:'غيّر الحزام.\nواحتفظ بأسلوبك.',personalText:'من الأسود إلى الفيروزي، ومن البيج إلى العنابي: كل الخيارات المعروضة موجودة في كتالوج WUPLY.',personalCta:'افتح أداة التخصيص',detailsLabel:'06 / المواد والتفاصيل',detailsTitle:'الشخصية\nفي التفاصيل.',detailsText:'النسيج والخياطة والألوان والتشطيبات المعدنية تصنع حضوراً هادئاً على المعصم.',appLabel:'07 / التطبيق',appTitle:'بياناتك.\nببساطة.',appText:'تطبيق مجاني، استخدام بسيط، وبدون اشتراك.',faqLabel:'08 / الأسئلة',faqTitle:'الأساسيات،\nبكل وضوح.',questions:[['كيف يعمل WUPLY؟','يرتبط الجهاز بحزام قابل للتبديل وتستمر التجربة في تطبيق الهاتف.'],['هل التطبيق مجاني؟','نعم، التطبيق مقدم كتطبيق مجاني.'],['هل أحتاج إلى اشتراك؟','لا يوجد اشتراك مخطط له.'],['هل يمكنني تغيير الحزام؟','نعم. يمكن استكشاف الخيارات التسعة عشر في أداة التخصيص.'],['هل السوار مقاوم للماء؟','تبقى مقاومة الماء خاضعة للمواصفات التجارية النهائية.']]}
}[lang];
const featured=[straps[0].variants[0],straps[0].variants[2],straps[0].variants[6],straps[1].variants[0],straps[1].variants[3]];
const metaTitle={fr:'WUPLY — La tech qui vous suit',en:'WUPLY — Wearable tech. Effortless style.',ar:'WUPLY — تقنية تُرتدى بأناقة'}[lang];
---
<Base lang={lang} title={metaTitle} description={s.description}>
 <ImmersiveHero lang={lang}/>
 <section class="benefit-bar" aria-label={c.benefits.join(', ')}>{c.benefits.map((item,i)=><div><span class="benefit-icon" aria-hidden="true">{['▯','≋','◇','ϟ'][i]}</span><strong>{item}</strong></div>)}</section>

 <section class="device-showcase" id="device"><div class="device-campaign"><img src="/images/wuply/device-campaign.webp" width="820" height="285" alt={alt.hero} loading="lazy" decoding="async"/></div><div class="device-showcase-copy wrap" data-reveal><span class="eyebrow">{c.deviceLabel}</span><h2>{c.deviceTitle}</h2><p>{c.deviceText}</p><a class="button light" href={`/${lang}/product/`}>{c.deviceCta}<ArrowIcon /></a></div></section>

 <section class="collections-light wrap" id="collections"><header data-reveal><span class="eyebrow">{c.collectionsLabel}</span><h2>{c.collectionsTitle}</h2></header><div class="collection-sheet-grid"><a href={`/${lang}/catalog/#classique`} class="sheet-card"><img src="/images/wuply/classiques-15.png" width="1536" height="1024" alt={`${s.classic} — 15 ${c.models}`} loading="lazy" decoding="async"/><div><span>15 {c.models}</span><h3>{s.classic}</h3><b aria-hidden="true"><ArrowIcon /></b></div></a><a href={`/${lang}/catalog/#originale`} class="sheet-card"><img src="/images/wuply/originaux-4.png" width="1536" height="1024" alt={`${s.original} — 4 ${c.models}`} loading="lazy" decoding="async"/><div><span>4 {c.models}</span><h3>{s.original}</h3><b aria-hidden="true"><ArrowIcon /></b></div></a></div></section>

 <section class="featured-products wrap" id="catalogue"><div class="section-title" data-reveal><div><span class="eyebrow">04 / {s.navCatalog}</span><h2>{c.selection}</h2><p>{c.selectionText}</p></div><a class="text-link" href={`/${lang}/catalog/`}>{s.all}<ArrowIcon /></a></div><BraceletCollections lang={lang} featured/></section>

 <section class="personalization-premium wrap"><div class="personal-copy" data-reveal><span class="eyebrow">{c.personalLabel}</span><h2>{c.personalTitle}</h2><p>{c.personalText}</p><a class="button light" href={`/${lang}/product/`}>{c.personalCta}<ArrowIcon /></a></div><div class="band-fan" data-reveal>{featured.map((v,i)=><a href={`/${lang}/product/?strap=${v.id}#configuration`} style={`--i:${i}`}><ResponsivePhoto image={v.image!} alt={v.name[lang]}/></a>)}</div></section>

 <section class="material-editorial wrap" id="details"><div class="material-image"><img src="/images/wuply/hero-campaign.webp" width="911" height="390" alt={alt.hero} loading="lazy" decoding="async"/></div><div class="material-copy" data-reveal><span class="eyebrow">{c.detailsLabel}</span><h2>{c.detailsTitle}</h2><p>{c.detailsText}</p></div><div class="material-copy material-copy--alt" data-reveal><span class="eyebrow">WUPLY / FINITIONS</span><h2>{s.colors}</h2><p>{s.detailsText}</p></div><div class="material-image material-image--original"><img src="/images/wuply/originaux-4.png" width="1536" height="1024" alt={alt.original} loading="lazy" decoding="async"/></div></section>

 <section class="app-experience" id="experience"><div class="app-orbit" aria-hidden="true"><span>W</span></div><div class="wrap" data-reveal><span class="eyebrow">{c.appLabel}</span><h2>{c.appTitle}</h2><p>{c.appText}</p></div></section>

 <section class="wuply-faq wrap" id="information"><header><span class="eyebrow">{c.faqLabel}</span><h2>{c.faqTitle}</h2></header><div class="faq">{c.questions.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}<div class="footer-anchors"><span id="delivery"></span><span id="returns"></span><span id="legal"></span></div></div></section>
</Base>
