---
import Base from '../../layouts/Base.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { locales, translations } from '../../i18n';
import { product } from '../../data/catalog';
export function getStaticPaths() { return locales.map(lang => ({params:{lang},props:{lang}})); }
const {lang} = Astro.props;
const t = translations[lang];
---
<Base lang={lang} title={`${t.hero.replace('\n', ' ')} — ${t.product}`}>
 <section class="hero wrap">
  <div class="hero-meta"><span class="eyebrow"><span class="status-dot"></span>{t.eyebrow}</span><span class="edition">{t.screenless} / 01</span></div>
  <h1>{t.hero}</h1>
  <div class="hero-bottom"><p>{t.intro}</p><a class="button light" href={`/${lang}/product/`}>{t.configure}<span>↗</span></a><span class="scroll-mark" aria-hidden="true">↓</span></div>
 </section>
 <section class="design-section wrap" id="design">
   <div class="section-head"><span class="eyebrow">{t.chapter}</span><span aria-hidden="true">↙</span></div>
   <div class="design-grid"><ProductVisual lang={lang}/><div class="design-copy"><h2>{t.design}</h2><p>{t.designText}</p><a class="text-link" href={`/${lang}/product/`}>{t.discover} ↗</a><ol class="feature-list"><li>{t.screenless}</li><li>{t.interchangeable}</li><li>{t.connected}</li></ol></div></div>
 </section>
 <section class="experience wrap" id="experience"><div class="experience-top"><span class="eyebrow">02 / {t.connected}</span><span aria-hidden="true">↗</span></div><h2>{t.appTitle}</h2><div class="experience-bottom"><span class="orbit" aria-hidden="true">↗</span><div><p>{t.appText}</p><span class="tiny">{t.appNote}</span></div></div></section>
 <section class="personal wrap"><span class="eyebrow">03 / {t.interchangeable}</span><div class="personal-content"><h2>{t.personalTitle}</h2><div><p>{t.personalText}</p><a class="button dark" href={`/${lang}/product/`}>{t.configure}<span>↗</span></a></div></div></section>
 <section class="collection wrap"><div class="collection-title"><h2>{t.collection}</h2><p>{t.collectionText}</p></div><a class="collection-row" href={`/${lang}/product/`}><span class="collection-number">01</span><h3>{product.name[lang]}</h3><span>{t.details} ↗</span></a></section>
 <section class="information wrap" id="information"><div><span class="eyebrow">04 / {t.useful}</span><h2>{t.demoTitle}</h2><p>{t.demoText}</p></div><div class="faq">{[1,2,3].map(n => <details><summary>{t[`faq${n}` as 'faq1']}<span aria-hidden="true">+</span></summary><p>{t[`answer${n}` as 'answer1']}</p></details>)}</div></section>
</Base>
