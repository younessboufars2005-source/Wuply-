---
import Base from '../../layouts/Base.astro';
import BraceletCollections from '../../components/BraceletCollections.astro';
import { locales } from '../../i18n';
import { storefront } from '../../i18n/storefront';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;const s=storefront[lang];
const filters={fr:['Tous','Classiques','Originaux'],en:['All','Classic','Original'],ar:['الكل','كلاسيكية','أصلية']}[lang];
---
<Base lang={lang} title={`${s.catalog} — ${s.colors}`} description={s.description} route="catalog/">
 <section class="wrap catalog-heading"><span class="eyebrow">WUPLY / {s.navCatalog}</span><h1>{s.catalog}</h1><div><p>{s.catalogIntro}</p><nav class="catalog-filters" aria-label={s.navCollections}><button type="button" class="is-active" data-filter="all">{filters[0]}<span>19</span></button><button type="button" data-filter="classique">{filters[1]}<span>15</span></button><button type="button" data-filter="originale">{filters[2]}<span>04</span></button></nav></div></section>
 <section class="wrap catalog-page"><BraceletCollections lang={lang}/><p class="catalog-note">{s.compatibility}</p></section>
 <script>
  const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const groups=document.querySelectorAll<HTMLElement>('[data-collection]');
  buttons.forEach(button=>button.addEventListener('click',()=>{
   const filter=button.dataset.filter;
   buttons.forEach(item=>item.classList.toggle('is-active',item===button));
   groups.forEach(group=>{group.hidden=filter!=='all'&&group.dataset.collection!==filter;});
  }));
 </script>
</Base>
