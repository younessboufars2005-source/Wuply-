---
import Base from '../../layouts/Base.astro';
import Checkout from '../../components/Checkout.astro';
import {locales,translations} from '../../i18n';
export function getStaticPaths() { return locales.map(lang => ({params:{lang},props:{lang}})); }
const {lang} = Astro.props; const t = translations[lang];
---
<Base lang={lang} title={`${t.checkout} — ${t.demo}`} route="checkout/"><section class="wrap page-heading"><a class="text-link" href={`/${lang}/cart/`}>← {t.back}</a><h1>{t.checkoutTitle}</h1></section><section class="wrap checkout-page"><Checkout lang={lang}/></section></Base>
