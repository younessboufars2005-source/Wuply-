---
import Base from '../../layouts/Base.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import Configurator from '../../components/Configurator';
import {locales,translations} from '../../i18n';
import {product} from '../../data/catalog';
import {storefront} from '../../i18n/storefront';
export function getStaticPaths() { return locales.map(lang => ({params:{lang},props:{lang}})); }
const {lang} = Astro.props; const t = translations[lang];
const s = storefront[lang];
---
<Base lang={lang} title={`${s.productTitle.replace('\n',' ')} — ${s.colors}`} description={s.productIntro} route="product/">
 <div class="wrap product-page-heading"><a class="text-link" href={`/${lang}/catalog/`}>← {s.back}</a><h1>{s.productTitle}</h1><p>{s.productIntro}</p></div>
 <section class="wrap premium-product-layout"><Configurator lang={lang} client:load/></section>
 <section class="wrap legacy-device"><details><summary>{s.device}<span>+</span></summary><div class="legacy-device-content"><ProductVisual lang={lang}/><div><h2>{product.name[lang]}</h2><p>{t.intro}</p><p>{t.designText}</p><span class="availability">{t.unavailable}</span>{product.images.slice(1).map(img => <img src={img.src} alt={img.alt[lang]} width={img.width} height={img.height} loading="lazy"/>)}</div></div></details></section>
</Base>
