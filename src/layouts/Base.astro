---
import '../styles/global.css';
import '../styles/image-quality.css';
import '../styles/storefront.css';
import { site } from '../config/site';
import { locales, translations } from '../i18n';
import type { Locale } from '../types/catalog';
import { storefront } from '../i18n/storefront';
interface Props { lang: Locale; title: string; description?: string; route?: string }
const { lang, title, description, route = '' } = Astro.props;
const t = translations[lang];
const s = storefront[lang];
const canonical = site.url ? new URL(`/${lang}/${route}`, site.url).href : undefined;
const pageTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const navCopy = {
  fr:{bands:'Bracelets',world:'Notre univers'},
  en:{bands:'Bands',world:'Our world'},
  ar:{bands:'الأحزمة',world:'عالمنا'}
}[lang];
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description || t.intro} />
    {(!site.indexable || route === 'cart/' || route === 'checkout/') && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {site.url && locales.map(l => <link rel="alternate" hreflang={l} href={new URL(`/${l}/${route}`, site.url).href} />)}
    {site.url && <link rel="alternate" hreflang="x-default" href={new URL(`/fr/${route}`, site.url).href} />}
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description || t.intro} />
    <meta property="og:type" content="website" /><meta property="og:locale" content={{fr:'fr_MA',en:'en_GB',ar:'ar_MA'}[lang]} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebPage',name:pageTitle,description:description || t.intro,url:canonical,inLanguage:lang,isPartOf:{'@type':'WebSite',name:site.name,url:site.url}}).replaceAll('<','\\u003c')} />}
    <meta name="theme-color" content="#08090B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header">
      <a class="wordmark" href={`/${lang}/`} aria-label={site.name || t.home}>
        {site.logo ? <img src={site.logo} alt={site.name} width="140" height="32" /> : site.name || <span class="brand-symbol" aria-hidden="true">◒</span>}
      </a>
      <nav class="desktop-nav" aria-label={t.menu}>
        <a href={`/${lang}/`}>{t.home}</a>
        <a href={`/${lang}/product/`} aria-current={route === 'product/' ? 'page' : undefined}>{t.product}</a>
        <a href={`/${lang}/catalog/`} aria-current={route === 'catalog/' ? 'page' : undefined}>{navCopy.bands}</a>
        <a href={`/${lang}/#experience`}>{navCopy.world}</a>
      </nav>
      <div class="header-tools">
        <nav class="languages" aria-label="FR / EN / العربية">{locales.map(l => <a href={`/${l}/${route}`} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}</nav>
        <a class="bag-link" href={`/${lang}/cart/`}><svg aria-hidden="true" width="19" height="22" viewBox="0 0 24 26" fill="none"><path d="M3 8h18l1 16H2L3 8Z" stroke="currentColor" stroke-width="1.4"/><path d="M8 9V6a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.4"/></svg><span>{t.cart}</span></a>
        <details class="mobile-menu"><summary aria-label={t.menu}><span></span><span></span></summary><nav aria-label={t.menu}><a href={`/${lang}/`}>{t.home}</a><a href={`/${lang}/product/`}>{t.product}</a><a href={`/${lang}/catalog/`}>{navCopy.bands}</a><a href={`/${lang}/#experience`}>{navCopy.world}</a><a href={`/${lang}/cart/`}>{t.cart}</a></nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="footer-main"><div><a class="wordmark" href={`/${lang}/`} aria-label={site.name || t.home}>{site.logo ? <img src={site.logo} alt={site.name} width="140" height="32"/> : site.name || <span class="brand-symbol" aria-hidden="true">◒</span>}</a><h2>{s.footerTitle}</h2><p>{s.footerText}</p></div>
        <nav aria-label={s.navCollections}><span class="eyebrow">{s.navCollections}</span><a href={`/${lang}/catalog/#classique`}>{s.classic}</a><a href={`/${lang}/catalog/#originale`}>{s.original}</a><a href={`/${lang}/catalog/`}>{s.navCatalog} ↗</a></nav>
        <nav aria-label={s.help}><span class="eyebrow">{s.help}</span><a href={`/${lang}/#information`}>{s.contact}</a><a href={`/${lang}/#delivery`}>{s.shipping}</a><a href={`/${lang}/#returns`}>{s.returns}</a><a href={`/${lang}/#legal`}>{s.legal}</a>{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}</nav>
      </div><div class="footer-bottom"><span>{s.commercial}</span><span>{s.independent}</span></div>
    </footer>
    <script>
      const header = document.querySelector('.header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      updateHeader(); window.addEventListener('scroll', updateHeader, {passive:true});
      document.querySelectorAll('.mobile-menu a').forEach(a => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
      document.addEventListener('keydown', e => { if(e.key === 'Escape') { const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu[open]'); menu?.removeAttribute('open'); menu?.querySelector('summary')?.focus(); }});
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}}), {threshold:.08});
        document.querySelectorAll('[data-reveal]').forEach(el => {el.classList.add('reveal-ready');observer.observe(el);});
      }
    </script>
  </body>
</html>
