---
import {heroMedia,usableHero} from '../config/hero';
import {storefront} from '../i18n/storefront';
import {visualAlt} from '../data/visuals';
import type {Locale} from '../types/catalog';
interface Props {lang:Locale}
const {lang}=Astro.props;
const s=storefront[lang];
const desktop=usableHero(heroMedia.desktop)?heroMedia.desktop:null;
const mobile=usableHero(heroMedia.mobile,true)?heroMedia.mobile:null;
const srcset=(image:NonNullable<typeof desktop>)=>image.sources?.filter(source=>source.width<=image.width).map(source=>`${source.src} ${source.width}w`).join(', ') || `${image.src} ${image.width}w`;
---
<section class:list={['store-hero','immersive-hero',{'has-desktop-photo':desktop,'has-mobile-photo':mobile}]}>
 {(desktop || mobile) && <picture class="immersive-background">
   {mobile && <source media="(max-width: 760px)" srcset={srcset(mobile)} sizes="100vw" width={mobile.width} height={mobile.height}/>}
   <img src={(desktop||mobile)!.src} srcset={srcset((desktop||mobile)!)} sizes="100vw" width={(desktop||mobile)!.width} height={(desktop||mobile)!.height} alt={visualAlt[lang].hero} loading="eager" fetchpriority="high" style={{'--hero-position':desktop?.position||'75% center','--hero-mobile-position':mobile?.position||'center'}}/>
 </picture>}
 <div class="immersive-content wrap"><div class="store-hero-copy"><span class="eyebrow">{s.tag}</span><h1>{s.hero}</h1><p>{s.intro}</p><a class="button light" href={`/${lang}/catalog/`}>{s.discover}<span>↗</span></a></div></div>
 <div class="hero-baseline wrap"><span>01 — 19</span><a href="#collections">{s.navCollections}<span aria-hidden="true">↓</span></a><span>{s.colors}</span></div>
</section>
