---
interface Props { direction?: 'up' | 'down'; class?: string }
const { direction = 'up', class: className = '' } = Astro.props;
---
<svg class:list={['arrow-icon', className, direction === 'down' && 'arrow-icon--down']} aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none">
  <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
</svg>
